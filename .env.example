# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The pgvector extension must be installed.
# Example (local dev): postgres://user:password@localhost/helpdocapp
DATABASE_URL=postgres://user:password@localhost/helpdocapp

# ── Source API ────────────────────────────────────────────────────────────────
# API key for the HelpScout-style article source.
API_KEY=your_api_key_here

# Base URL for the article source API (no trailing slash).
API_BASE_URL=https://docsapi.helpscout.net/v1

# HTTP timeout in seconds for calls to the source API. Default: 30.
# Increase for slow or heavily-paginated sources.
API_TIMEOUT_SECS=30

# ── Job queue ─────────────────────────────────────────────────────────────────
# Number of concurrent worker threads for the background job queue. Default: 4.
JOB_QUEUE_WORKERS=4

# Minimum milliseconds between jobs dispatched by the queue. Default: 100.
JOB_QUEUE_RATE_LIMIT_MS=100

# ── Ollama (LLM inference) ────────────────────────────────────────────────────
# Ollama is expected at http://localhost:11434 by default (ollama-rs default).
# If running Ollama on a non-standard port, set this. Uncomment to override.
# OLLAMA_HOST=http://localhost:11434

# ── Python embedding service ──────────────────────────────────────────────────
# The embedding microservice is expected at http://localhost:8080.
# Start it with: cd python_services && python embedding_service.py
# No env var needed unless you change the port in embedding_service.py.
